    "Business": {"role": "compute", "icon": "code", "width": 390, "row": 0, "column": 0, "details": ["Computed totals; invalid input -> HTTP 400"]},
    "Participant": {"role": "state", "icon": "grid", "width": 390, "row": 1, "column": 0, "details": ["Mirrored CIDRs/AZs, not the owner's physical VPC"]},
    "RamShare": {"role": "state", "icon": "document", "width": 390, "row": 0, "column": 0, "details": ["Native associations may remain ASSOCIATING"]},
    "OwnerVpc": {"role": "data", "icon": "grid", "width": 390, "row": 1, "column": 0, "details": ["IDs/CIDRs checked; missing owner blocks request"]}
  },
  "edges": {
    "static": {"role": "pipeline"},
    "read": {"role": "data"},
    "api": {"role": "crossing"},
    "check": {"role": "crossing"},
    "invoke": {"role": "compute"},
    "ram": {"role": "data"},
    "owner": {"role": "data"},
    "map": {"role": "crossing"},
    "config": {"role": "state"}
