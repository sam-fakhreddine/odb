{
  "version": 1,
  "preset": "aws-architecture",
  "header": {
    "title": "Three Accounts. Two Explicit Seams.",
    "subtitle": "The ODB quote example: native components, adapted API transport, and checked subnet fixtures.",
    "mark": "ODB",
    "badges": ["Local three-tier demo", "Logical account IDs", "Not AWS packet-flow proof"]
  },
  "groups": {
    "Demo": {"role": "crossing", "layout": "grid", "columns": 3, "row": 0, "column": 0, "icon": "merge"},
