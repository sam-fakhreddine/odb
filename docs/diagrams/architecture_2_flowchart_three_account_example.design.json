  "legend": [
    {"role": "pipeline", "label": "Solid: real native operation"},
    {"role": "crossing", "label": "Orange dashed: explicit fixture", "dashed": true},
    {"role": "state", "label": "Purple dashed: configuration, not packets", "dashed": true}
  ],
  "callouts": [
    {"title": "Native Results", "role": "success", "icon": "database", "details": ["HTML bytes, code ZIP and computed totals are checked."]},
    {"title": "Explicit Fixtures", "role": "crossing", "icon": "arrows", "details": ["API transport and mirrored subnet configuration are adapter code."]},
    {"title": "Strict Native Stays Red", "role": "expert", "icon": "shield", "details": ["1.0.322: cross-process CF/Lambda -> 502; RAM invisible; invalid subnet accepted."]}
  ],
  "notes": [
    "Strict native mode stays red on emulator 1.0.322: cross-process CloudFront/Lambda URL -> 502; RAM subnets not visible; invalid Lambda subnet accepted.",
