    "Web": {"role": "pipeline", "layout": "grid", "columns": 1, "row": 0, "column": 0, "icon": "route"},
    "Application": {"role": "compute", "layout": "grid", "columns": 1, "row": 0, "column": 1, "icon": "code"},
    "Network": {"role": "data", "layout": "grid", "columns": 1, "row": 0, "column": 2, "icon": "grid"}
  },
  "nodes": {
    "FrontDoor": {"role": "pipeline", "icon": "server", "width": 390, "row": 0, "column": 0, "details": ["Static requests reach native CloudFront"]},
    "ApiRelay": {"role": "crossing", "icon": "arrows", "width": 390, "row": 0, "column": 1, "details": ["Forwards inputs, nonce and native result"]},
    "SubnetFixture": {"role": "crossing", "icon": "merge", "width": 390, "row": 0, "column": 2, "details": ["Creates and checks mirrors; not shared networking"]},
    "CloudFront": {"role": "pipeline", "icon": "route", "width": 390, "row": 0, "column": 0, "details": ["OAC read; absent origin grant -> HTTP 403"]},
